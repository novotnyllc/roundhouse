#!/usr/bin/env bash
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
plugin_root=$(CDPATH='' cd -- "$script_dir/.." && pwd)
output=$plugin_root/integrity.json

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print tolower($1)}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print tolower($1)}'
  else
    openssl dgst -sha256 "$1" | awk '{print tolower($NF)}'
  fi
}

command -v jq >/dev/null 2>&1 || {
  printf 'update-integrity: jq is required\n' >&2
  exit 69
}

version=$(jq -r '.version' "$plugin_root/.codex-plugin/plugin.json")
[ "$version" = "$(jq -r '.version' "$plugin_root/.claude-plugin/plugin.json")" ] || {
  printf 'update-integrity: plugin manifest versions differ\n' >&2
  exit 65
}

tmp=$(mktemp -d "${TMPDIR:-/tmp}/roundhouse-integrity.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
: >"$tmp/files.jsonl"
for relative in \
  .claude-plugin/plugin.json \
  .codex-plugin/plugin.json \
  references/privilege-policy.default \
  references/windows-winget-provider.lock \
  scripts/apply-windows.ps1 \
  scripts/codex-plugin-hooks.mjs \
  scripts/certify-ssh-node \
  scripts/collect-posix \
  scripts/collect-windows.ps1 \
  scripts/enroll-privilege-posix \
  scripts/enroll-privilege-windows.ps1 \
  scripts/enroll-ssh-posix \
  scripts/enroll-windows-sftp.ps1 \
  scripts/homebrew-bridge.rb \
  scripts/roundhouse \
  scripts/prepare-ssh-identity \
  scripts/privilege-broker-posix \
  scripts/privilege-broker-windows.ps1 \
  scripts/profile-worker-windows.ps1 \
  scripts/register-profile-task-windows.ps1 \
  scripts/windows-native-canary-runner.ps1
do
  [ -f "$plugin_root/$relative" ] || {
    printf 'update-integrity: missing release file: %s\n' "$relative" >&2
    exit 66
  }
  jq -cn --arg path "$relative" --arg sha256 "$(sha256_file "$plugin_root/$relative")" \
    '{path:$path,sha256:$sha256}' >>"$tmp/files.jsonl"
done

jq -S -n --arg version "$version" --slurpfile files "$tmp/files.jsonl" '{
  schema:"roundhouse.integrity",
  schema_version:1,
  plugin:"roundhouse",
  marketplace:"novotnyllc",
  version:$version,
  files:($files | sort_by(.path))
}' >"$tmp/integrity.json"

chmod 600 "$tmp/integrity.json"
mv -f "$tmp/integrity.json" "$output"
