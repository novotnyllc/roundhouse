#!/usr/bin/env bash
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
plugin_root=$(CDPATH='' cd -- "$script_dir/.." && pwd)
output=$plugin_root/integrity.json
# Not release content: the self-check suite and the sections it sources, and
# this generator itself (its own hash cannot be written into the manifest it
# produces). Kept byte-identical to executor-status's copy in scripts/roundhouse.
integrity_excluded_scripts='scripts/(test-roundhouse|update-integrity|tests/.+)'

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print tolower($1)}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print tolower($1)}'
  else
    openssl dgst -sha256 "$1" | awk '{print tolower($NF)}'
  fi
}

command -v jq >/dev/null 2>&1 || {
  printf 'update-integrity: jq is required\n' >&2
  exit 69
}

version=$(jq -r '.version' "$plugin_root/.codex-plugin/plugin.json")
[ "$version" = "$(jq -r '.version' "$plugin_root/.claude-plugin/plugin.json")" ] || {
  printf 'update-integrity: plugin manifest versions differ\n' >&2
  exit 65
}

tmp=$(mktemp -d "${TMPDIR:-/tmp}/roundhouse-integrity.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
: >"$tmp/files.jsonl"
# Enumerated, never hand-listed: a hardcoded list silently stops covering the
# next file added under scripts/, which then ships unhashed. executor-status
# derives the same set with the same exclusions and fails closed on a
# difference, so the two can never drift apart unnoticed.
{
  printf '%s\n' .claude-plugin/plugin.json .codex-plugin/plugin.json
  # THE ROOTS ARE THE WHOLE SHIPPED TREE, not just the executable half. Rooting
  # this at `scripts references` left every `SKILL.md` — the operator-facing
  # instruction set an agent reads and acts on — plus `agents/*.yaml`,
  # `config.example.json` and `assets/` shipping unhashed. Instructions are
  # release content in exactly the sense the manifest exists for.
  (cd "$plugin_root" && find scripts references skills assets \
    config.example.json ! -type d -print) |
    grep -Ev "^$integrity_excluded_scripts\$" |
    LC_ALL=C sort
} >"$tmp/paths"
while IFS= read -r relative; do
  [ -n "$relative" ] || continue
  [ -f "$plugin_root/$relative" ] || {
    printf 'update-integrity: missing release file: %s\n' "$relative" >&2
    exit 66
  }
  jq -cn --arg path "$relative" --arg sha256 "$(sha256_file "$plugin_root/$relative")" \
    '{path:$path,sha256:$sha256}' >>"$tmp/files.jsonl"
done <"$tmp/paths"
[ -s "$tmp/files.jsonl" ] || {
  printf 'update-integrity: no release files found\n' >&2
  exit 66
}

jq -S -n --arg version "$version" --slurpfile files "$tmp/files.jsonl" '{
  schema:"roundhouse.integrity",
  schema_version:1,
  plugin:"roundhouse",
  marketplace:"novotnyllc",
  version:$version,
  files:($files | sort_by(.path))
}' >"$tmp/integrity.json"

chmod 600 "$tmp/integrity.json"
mv -f "$tmp/integrity.json" "$output"
