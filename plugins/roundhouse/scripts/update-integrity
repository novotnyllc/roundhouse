#!/usr/bin/env bash
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
plugin_root=$(CDPATH='' cd -- "$script_dir/.." && pwd)
output=$plugin_root/integrity.json
# Not release content: the self-check suite and the sections it sources, and
# this generator itself (its own hash cannot be written into the manifest it
# produces). Kept byte-identical to executor-status's copy in scripts/roundhouse.
integrity_excluded_scripts='scripts/(test-roundhouse|update-integrity|tests/.+)'

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print tolower($1)}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print tolower($1)}'
  else
    openssl dgst -sha256 "$1" | awk '{print tolower($NF)}'
  fi
}

command -v jq >/dev/null 2>&1 || {
  printf 'update-integrity: jq is required\n' >&2
  exit 69
}

version=$(jq -r '.version' "$plugin_root/.codex-plugin/plugin.json")
[ "$version" = "$(jq -r '.version' "$plugin_root/.claude-plugin/plugin.json")" ] || {
  printf 'update-integrity: plugin manifest versions differ\n' >&2
  exit 65
}

tmp=$(mktemp -d "${TMPDIR:-/tmp}/roundhouse-integrity.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
: >"$tmp/files.jsonl"
# Enumerate the TRACKED release tree with git ls-files, never a working-dir
# find: only committed or staged files are release content, so OS cruft (a
# macOS .DS_Store, an editor scratch file) can never be sealed even while it
# sits in the tree, and the set is identical on every checkout. The roots are
# the whole shipped tree — .claude-plugin/.codex-plugin manifests, every
# SKILL.md, agents/*.yaml, config.example.json and assets/ are the
# operator-facing instructions an agent acts on, release content in exactly the
# sense the manifest exists for — not just the executable half. executor-status
# cross-checks coverage over the same tracked scripts/ set and fails closed on
# any file it omits. A new release file must be `git add`ed before it can be
# sealed, then committed alongside the manifest.
if ! { command -v git >/dev/null 2>&1 &&
  git -C "$plugin_root" rev-parse --is-inside-work-tree >/dev/null 2>&1; }; then
  printf 'update-integrity: must run inside the git work tree\n' >&2
  exit 69
fi
git -C "$plugin_root" ls-files -- \
  .claude-plugin/plugin.json .codex-plugin/plugin.json \
  scripts references skills assets config.example.json |
  grep -Ev "^$integrity_excluded_scripts\$" |
  LC_ALL=C sort >"$tmp/paths"
while IFS= read -r relative; do
  [ -n "$relative" ] || continue
  [ -f "$plugin_root/$relative" ] || {
    printf 'update-integrity: missing release file: %s\n' "$relative" >&2
    exit 66
  }
  jq -cn --arg path "$relative" --arg sha256 "$(sha256_file "$plugin_root/$relative")" \
    '{path:$path,sha256:$sha256}' >>"$tmp/files.jsonl"
done <"$tmp/paths"
[ -s "$tmp/files.jsonl" ] || {
  printf 'update-integrity: no release files found\n' >&2
  exit 66
}

jq -S -n --arg version "$version" --slurpfile files "$tmp/files.jsonl" '{
  schema:"roundhouse.integrity",
  schema_version:1,
  plugin:"roundhouse",
  marketplace:"novotnyllc",
  version:$version,
  files:($files | sort_by(.path))
}' >"$tmp/integrity.json"

chmod 600 "$tmp/integrity.json"
mv -f "$tmp/integrity.json" "$output"
