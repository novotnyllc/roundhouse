#!/bin/bash
# Runs the gate AGENTS.md already mandates, before a push rather than after it.
#
# Every mechanical defect a reviewer caught on #17 was catchable here and was
# only caught because a human-facing review round paid for it:
#   - integrity.json left stale after editing a hashed file
#   - a `perl` replacement that ate `@appArgs` (Perl array interpolation) so the
#     documented install command silently lost its --app argument
#   - `$appPath` tested but never assigned, making the preflight vacuous
#
# The first is a direct AGENTS.md requirement. The others are shell/PowerShell
# snippets embedded in SKILL.md, which are shipped instructions: if a snippet
# reads a variable it never assigns, the documented procedure is broken for
# every user who follows it, and nothing else in the suite looks at them.
#
# Usage: plugins/roundhouse/scripts/preflight
# Exit non-zero on any failure. Safe to run repeatedly.
set -uo pipefail

cd "$(dirname "$0")/../../.." || exit 1
fail=0
note() { printf '%s\n' "$*" >&2; }

# --- 1. integrity manifest is regenerated and committed --------------------
plugins/roundhouse/scripts/update-integrity >/dev/null 2>&1
if ! git diff --quiet -- plugins/roundhouse/integrity.json; then
  note "FAIL integrity.json is stale — update-integrity changed it. Stage the result."
  fail=1
else
  note "ok   integrity.json current"
fi

# --- 2. shipped snippets reference only variables they assign --------------
# Deliberately checks the SHIPPED docs, not a copy: a snippet is an instruction
# a user will paste, so an unassigned variable is a broken procedure, not a nit.
snippet_check=$(node - <<'NODE'
const fs = require("fs");
const path = require("path");
let bad = 0;
const files = [];
const walk = (d) => {
  for (const e of fs.readdirSync(d, { withFileTypes: true })) {
    const p = path.join(d, e.name);
    if (e.isDirectory()) walk(p);
    else if (e.name === "SKILL.md") files.push(p);
  }
};
if (fs.existsSync("plugins/roundhouse/skills")) walk("plugins/roundhouse/skills");

// Shell builtins and documented caller-supplied values.
const KNOWN = new Set(["SkillDir", "_", "LASTEXITCODE", "PSScriptRoot", "args", "true", "false", "null", "env"]);

for (const file of files) {
  const text = fs.readFileSync(file, "utf8");
  const blocks = [...text.matchAll(/```powershell\n([\s\S]*?)\n```/g)].map((m) => m[1]);
  // Snippets in one doc are a SEQUENCE the reader pastes in order, so a value
  // assigned in an earlier block is legitimately in scope later. Accumulate
  // rather than resetting per block - otherwise every multi-step procedure
  // reports false failures and the gate gets ignored, which is worse than not
  // having it.
  const assigned = new Set();
  for (const block of blocks) {
    for (const m of block.matchAll(/\$([A-Za-z_][A-Za-z0-9_]*)\s*=/g)) assigned.add(m[1]);
  }
  for (const block of blocks) {
    for (const m of block.matchAll(/\$(?!env:)([A-Za-z_][A-Za-z0-9_]*)/g)) {
      const name = m[1];
      if (assigned.has(name) || KNOWN.has(name)) continue;
      console.error(`FAIL ${file}: PowerShell snippet reads $${name} but nothing assigns it`);
      bad = 1;
    }
  }
}
process.exit(bad);
NODE
) || fail=1
[ -n "$snippet_check" ] && note "$snippet_check"
[ "$fail" -eq 0 ] && note "ok   shipped snippets assign what they read"

# --- 3. the shim self-test -------------------------------------------------
if node plugins/roundhouse/scripts/mcp-siding.selftest.mjs >/dev/null 2>&1; then
  note "ok   mcp-siding selftest"
else
  note "FAIL mcp-siding selftest"
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  note ""
  note "preflight FAILED — fix the above before pushing."
  exit 1
fi
note ""
note "preflight PASSED"
