#!/usr/bin/env bash
if [ "$#" -eq 4 ] && [ "$1" = clone ] && [ "$2" = -- ] &&
  [ "$3" = https://github.com/owner/clone-example.git ]; then
  "$REAL_GIT" clone -q -- "$GIT_CLONE_FIXTURE" "$4" &&
    "$REAL_GIT" -C "$4" remote set-url origin "$3"
