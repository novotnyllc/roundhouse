jq '.agent_artifacts[] |= if .id == "claude-settings" then .settings.apiKey = "unsafe" else . end' \
  "$tmp/config.json" >"$tmp/invalid-agent-setting.json"
if ROUNDHOUSE_CONFIG="$tmp/invalid-agent-setting.json" \
