        'Name  Id  Version  Available  Source' \
        '----  --  -------  ---------  ------' \
        'Example  Example.Package  1.0.0  2.0.0  winget'
    fi
    ;;
  export)
    shift
    while [ $# -gt 0 ]; do
      case $1 in
        --output) output=$2; shift 2 ;;
        *) shift ;;
      esac
    done
    printf '%s\n' \
      '{"Sources":[{"SourceDetails":{"Name":"winget"},"Packages":[{"PackageIdentifier":"Example.Package","Version":"1.0.0"}]}]}' \
      >"$output"
    ;;
  *) exit 64 ;;
esac
