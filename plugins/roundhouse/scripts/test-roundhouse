#!/usr/bin/env bash
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
cli="$script_dir/roundhouse"
plugin_version=$(jq -r '.version' "$script_dir/../.codex-plugin/plugin.json")
pwsh_command=$(command -v pwsh 2>/dev/null || true)
real_git=$(command -v git)
real_stat=$(command -v stat)
real_node=$(command -v node)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/roundhouse-test.XXXXXX")
cleanup_test_tmp() {
  if [ "${ROUNDHOUSE_TEST_KEEP_TMP:-false}" = true ]; then
    printf 'preserved-test-root|%s\n' "$tmp" >&2
  else
    rm -rf "$tmp"
  fi
}
trap cleanup_test_tmp EXIT HUP INT TERM
mkdir -p "$tmp/home/dev/example" "$tmp/bin"

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

assert_contains() {
  case $1 in
    *"$2"*) ;;
    *) fail "expected output to contain: $2" ;;
  esac
}

assert_ordered() {
  first_line=$(grep -nF -- "$2" "$1" | head -1 | cut -d: -f1)
  second_line=$(grep -nF -- "$3" "$1" | head -1 | cut -d: -f1)
  [ -n "$first_line" ] && [ -n "$second_line" ] && [ "$first_line" -lt "$second_line" ] ||
    fail "expected ordered contract: $2 before $3"
}

# Portable file stat for fixtures. Always GNU `stat -c` first, BSD/macOS
# `stat -f` as the fallback — never `stat -f` first: on Linux `stat -f` is
# FILESYSTEM stat and prints a report to stdout that the `||` form would splice
# into the value. Every fixture that stats a file goes through these so the
# idiom lives in one place.
t_size()   { stat -c %s "$1" 2>/dev/null || stat -f %z  "$1"; }
t_blocks() { stat -c %b "$1" 2>/dev/null || stat -f %b  "$1"; }
t_device() { stat -c %d "$1" 2>/dev/null || stat -f %d  "$1"; }
t_mode()   { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }

# A section that only applies to one OS gates on this and lives in its own
# clearly-named file (e.g. 50-macos-privilege.sh). Only genuinely
# platform-specific fixtures may gate; everything else must run on every OS.
skip_unless_darwin() {
  [ "$(uname -s)" = Darwin ] && return 1
  printf 'skip: %s runs only on macOS\n' "$1"
  return 0
}

# The CLI is an entrypoint plus the units it sources from lib/. Fixtures that
# assert on its text go through these two, so no fixture has to know which unit
# a definition landed in — or where inside that unit it sits.
cli_program_files() {
  printf '%s\n' "$cli" "$(dirname -- "$cli")"/lib/*.sh
}

cli_program_contains() {
  # shellcheck disable=SC2046 # deliberate word splitting over the file list
  grep -Fq -- "$1" $(cli_program_files)
}

cli_function_body() {
  # shellcheck disable=SC2046 # deliberate word splitting over the file list
  cli_unit=$(grep -lE "^$1\(\) *[({]$" $(cli_program_files) || true)
  [ "$(printf '%s' "$cli_unit" | grep -c . || true)" -eq 1 ] ||
    fail "expected exactly one CLI unit to define $1"
  sed -n "/^$1() *[({]$/,/^[)}]$/p" "$cli_unit"
}

# The suite is one program: sequential fixtures over shared mutable state,
# under `set -eu`. The sections below are SOURCED in this fixed order,
# never run as separate files — shared state and fail-fast stay exactly
# what they were when this was one file, and a section that exits early
# (the ROUNDHOUSE_TEST_SCOPE shortcuts) still ends the whole run.
# Select a subset of test sections for a fast inner loop; unset runs everything,
# which is the release gate. ROUNDHOUSE_TEST_ONLY is a space list of section
# number prefixes (e.g. "94 95"); ROUNDHOUSE_TEST_TIER is fast (pre-jj) or jj
# (real-jj). The 00/05/07 harness sections and the 90 real-jj fixtures are
# prerequisites and run whenever a dependent section does. Sources stay static
# below so shellcheck -x still analyses every section as part of the program.
want_section() {
  n=$1
  case "$n" in 00|05|07) return 0 ;; esac
  case "${ROUNDHOUSE_TEST_TIER:-all}" in
    fast) [ "$n" -lt 90 ] || return 1 ;;
    jj)   [ "$n" -ge 90 ] || return 1 ;;
  esac
  [ -n "${ROUNDHOUSE_TEST_ONLY:-}" ] || return 0
  if [ "$n" -eq 90 ]; then
    for s in $ROUNDHOUSE_TEST_ONLY; do
      case "$s" in ''|*[!0-9]*) continue ;; esac
      [ "$s" -ge 90 ] && return 0
    done
    return 1
  fi
  case " $ROUNDHOUSE_TEST_ONLY " in *" $n "*) return 0 ;; *) return 1 ;; esac
}

# shellcheck source=tests/00-contracts.sh
if want_section 00; then . "$script_dir/tests/00-contracts.sh"; fi
# shellcheck source=tests/05-fixture-tree.sh
if want_section 05; then . "$script_dir/tests/05-fixture-tree.sh"; fi
# shellcheck source=tests/07-stubs.sh
if want_section 07; then . "$script_dir/tests/07-stubs.sh"; fi
# shellcheck source=tests/10-u2-broker.sh
if want_section 10; then . "$script_dir/tests/10-u2-broker.sh"; fi
# shellcheck source=tests/12-u2-enrollment.sh
if want_section 12; then . "$script_dir/tests/12-u2-enrollment.sh"; fi
# shellcheck source=tests/14-u2-collector.sh
if want_section 14; then . "$script_dir/tests/14-u2-collector.sh"; fi
# shellcheck source=tests/20-u1.sh
if want_section 20; then . "$script_dir/tests/20-u1.sh"; fi
# shellcheck source=tests/30-u4.sh
if want_section 30; then . "$script_dir/tests/30-u4.sh"; fi
# shellcheck source=tests/40-u5.sh
if want_section 40; then . "$script_dir/tests/40-u5.sh"; fi
# shellcheck source=tests/50-macos-privilege.sh
if want_section 50; then . "$script_dir/tests/50-macos-privilege.sh"; fi
# shellcheck source=tests/60-executor-windows.sh
if want_section 60; then . "$script_dir/tests/60-executor-windows.sh"; fi
# shellcheck source=tests/65-config-validation.sh
if want_section 65; then . "$script_dir/tests/65-config-validation.sh"; fi
# shellcheck source=tests/67-windows-collector.sh
if want_section 67; then . "$script_dir/tests/67-windows-collector.sh"; fi
# shellcheck source=tests/68-plan-lifecycle.sh
if want_section 68; then . "$script_dir/tests/68-plan-lifecycle.sh"; fi
# shellcheck source=tests/70-fold.sh
if want_section 70; then . "$script_dir/tests/70-fold.sh"; fi
# shellcheck source=tests/71-definitions.sh
if want_section 71; then . "$script_dir/tests/71-definitions.sh"; fi
# shellcheck source=tests/72-records.sh
if want_section 72; then . "$script_dir/tests/72-records.sh"; fi
# shellcheck source=tests/73-ladder.sh
if want_section 73; then . "$script_dir/tests/73-ladder.sh"; fi
# shellcheck source=tests/74-run.sh
if want_section 74; then . "$script_dir/tests/74-run.sh"; fi
# shellcheck source=tests/75-guards.sh
if want_section 75; then . "$script_dir/tests/75-guards.sh"; fi
# shellcheck source=tests/78-fleet-parked.sh
if want_section 78; then . "$script_dir/tests/78-fleet-parked.sh"; fi
# shellcheck source=tests/90-jj-bootstrap.sh
if want_section 90; then . "$script_dir/tests/90-jj-bootstrap.sh"; fi
# shellcheck source=tests/91-jj-integrity.sh
if want_section 91; then . "$script_dir/tests/91-jj-integrity.sh"; fi
# shellcheck source=tests/92-jj-reconcile.sh
if want_section 92; then . "$script_dir/tests/92-jj-reconcile.sh"; fi
# shellcheck source=tests/93-jj-run.sh
if want_section 93; then . "$script_dir/tests/93-jj-run.sh"; fi
# shellcheck source=tests/94-jj-doctor.sh
if want_section 94; then . "$script_dir/tests/94-jj-doctor.sh"; fi
# shellcheck source=tests/95-jj-trustd.sh
if want_section 95; then . "$script_dir/tests/95-jj-trustd.sh"; fi
# shellcheck source=tests/96-u20-chezmoi-absent.sh
if want_section 96; then . "$script_dir/tests/96-u20-chezmoi-absent.sh"; fi
# shellcheck source=tests/97-jj-reenrollment.sh
if want_section 97; then . "$script_dir/tests/97-jj-reenrollment.sh"; fi

printf 'PASS: roundhouse self-check\n'
