#!/usr/bin/env bash
# git merge driver for plugin manifests. Invoked as: %O %A %B
#
# Plugin versions only ever increment, so a version-only conflict has one
# correct answer — the higher version — and resolving it by hand on every
# stacked merge is pure churn. `merge=ours` is NOT good enough here: it keeps
# the CURRENT branch's version even when main has moved ahead, which silently
# regresses the release number.
#
# Deliberately narrow. It resolves ONLY when the two sides are identical apart
# from the version field: anything else is a real content conflict and is left
# for a human, exit 1 and all. A driver that "helpfully" resolved a description
# or role-list conflict by picking a side would hide a decision.
set -uo pipefail
ancestor=$1 ours=$2 theirs=$3

command -v jq >/dev/null 2>&1 || exit 1

va=$(jq -r '.version // empty' "$ours" 2>/dev/null) || exit 1
vb=$(jq -r '.version // empty' "$theirs" 2>/dev/null) || exit 1
[ -n "$va" ] && [ -n "$vb" ] || exit 1

# Highest wins. sort -V understands dotted versions; picking max rather than
# "theirs" is what makes this safe in both merge directions.
winner=$(printf '%s\n%s\n' "$va" "$vb" | sort -V 2>/dev/null | tail -1) || winner=
# FAIL CLOSED. There is no errexit here, so without this check a `sort` that
# lacks -V leaves $winner empty, both manifests normalize to version "" and
# compare equal, and the driver writes `"version": ""` and exits 0 — silently
# corrupting both manifests while reporting a clean resolve. A merge driver
# that cannot determine the answer must refuse, not guess.
case $winner in
  "" ) exit 1 ;;
  *[!0-9.]* ) exit 1 ;;
esac
# And it must actually be one of the two inputs, never something sort invented.
[ "$winner" = "$va" ] || [ "$winner" = "$vb" ] || exit 1

# Are the sides otherwise identical? Normalize BOTH to the winning version and
# compare the whole document. If anything else differs, this is not a version
# conflict and must not be auto-resolved.
norm_a=$(jq -S --arg v "$winner" '.version = $v' "$ours" 2>/dev/null) || exit 1
norm_b=$(jq -S --arg v "$winner" '.version = $v' "$theirs" 2>/dev/null) || exit 1
[ "$norm_a" = "$norm_b" ] || exit 1

# Write the merged result to %A, preserving our formatting with only the
# version changed.
tmp=$(mktemp) || exit 1
jq --arg v "$winner" '.version = $v' "$ours" > "$tmp" 2>/dev/null || { rm -f "$tmp"; exit 1; }
mv -- "$tmp" "$ours" || exit 1
exit 0
