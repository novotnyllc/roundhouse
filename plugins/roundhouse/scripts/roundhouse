#!/usr/bin/env bash
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
plugin_root=$(CDPATH='' cd -- "$script_dir/.." && pwd)
repository_root=$(CDPATH='' cd -- "$plugin_root/../.." && pwd)
schema=roundhouse.inventory
schema_version=1
maximum_windows_broker_payload_bytes=67108864
# Scripts that are not release content, so the integrity manifest never covers
# them: the self-check driver, the sections it sources, and the manifest
# generator. Kept byte-identical to scripts/update-integrity's copy: the
# generator and this verifier must enumerate exactly the same set.
integrity_excluded_scripts='scripts/(test-roundhouse|update-integrity|tests/.+)'

usage() {
  cat >&2 <<'EOF'
Usage:
  roundhouse validate-config
  roundhouse validate-privilege-policy POLICY
  roundhouse inspect-privilege-constraints POLICY CONSTRAINTS
  roundhouse check-mutation-config
  roundhouse worker-config HOST DOMAIN OUTPUT.json
  roundhouse collect [--target HOST] [--native-target] [--section SECTION]... [--output FILE|-]
  roundhouse validate SNAPSHOT.jsonl|-
  roundhouse render [--format human|json|jsonl] SNAPSHOT.jsonl|-
  roundhouse compare LEFT.jsonl RIGHT.jsonl
  roundhouse executor-status [OUTPUT.json|-]
  roundhouse verify-executor [REQUIREMENT.json]
  roundhouse approve-codex-plugin-hooks PLUGIN@MARKETPLACE
  roundhouse update-codex-plugin PLUGIN@MARKETPLACE
  roundhouse privilege-status TARGET OUTPUT.jsonl|-
  roundhouse prepare-privilege-identity FLEET-DOMAIN NODE-ID ENDPOINT-PRINCIPALS SOURCE-CIDRS OUTPUT|-
  roundhouse prepare-privilege-enrollment TARGET OUTPUT.json|-
  roundhouse record-codex-readiness SNAPSHOT.jsonl METADATA.json OUTPUT.jsonl
  roundhouse profile-bundle SPEC.json SOURCE-ROOT OUTPUT.bundle
  roundhouse seal-plan DRAFT.json SNAPSHOT.jsonl PLAN.json
  roundhouse verify-preconditions PLAN.json CURRENT-SNAPSHOT.jsonl
  roundhouse verify-privilege-plan PLAN.json CURRENT-SNAPSHOT.jsonl
  roundhouse apply-plan PLAN.json PLAN-ID OUTPUT.jsonl
  roundhouse submit-privilege-plan PLAN.json PLAN-ID OUTPUT.jsonl
  roundhouse lookup-privilege-result PLAN.json OPERATION-INDEX OUTPUT
  roundhouse preview-privilege-upgrade TARGET OUTPUT.json|-
  roundhouse preview-privilege-revocation TARGET OUTPUT.json|-
  roundhouse apply-native-plan PLAN.json PLAN-ID OUTPUT.jsonl
  roundhouse apply-ssh-plan PLAN.json PLAN-ID OUTPUT.jsonl
  roundhouse dispatch-posix-request
  roundhouse fleet-init
  roundhouse fleet-enroll
  roundhouse fleet-add HOST [--ephemeral] [--job JOB] [--ttl HOURS]
  roundhouse fleet-join REMOTE
  roundhouse fleet-remove HOST [--burn] [--authority-receipt RECEIPT]
  roundhouse fleet-renew NAME [HOURS]
  roundhouse fleet-reparent
  roundhouse fleet-reconstitute HOST
  roundhouse fleet-checkpoint
  roundhouse fleet-reroot [--authority-receipt RECEIPT]
  roundhouse fleet-explain [HOST] ITEM
  roundhouse fleet-run [--fast|--full]
  roundhouse fleet-seed
  roundhouse fleet-review ITEM pass|hold REASON
  roundhouse fleet-apply ITEM
  roundhouse fleet-accept SLUG
  roundhouse fleet-hold ITEM REASON
  roundhouse fleet-pending
  roundhouse fleet-journal ENTRY.json|-
  roundhouse fleet-finding SLUG SUMMARY [QUOTE]
  roundhouse fleet-lock
  roundhouse fleet-unlock
  roundhouse fleet-rollback ITEM [--now]
  roundhouse fleet-adopt-pin PLUGIN PIN.json
  roundhouse fleet-verify-remote
  roundhouse fleet-set-remote URL
  roundhouse fleet-readiness [HOST]...
  roundhouse fleet-doctor
  roundhouse launcher-install [DESTINATION]
  roundhouse ensure-tools
EOF
  exit 64
}

# Definitions live in lib/, sourced unconditionally in dependency
# order. No lazy or conditional sourcing: one fixed list, so every
# invocation loads exactly the same program.
# shellcheck source=lib/host.sh
. "$script_dir/lib/host.sh"
# shellcheck source=lib/identity.sh
. "$script_dir/lib/identity.sh"
# shellcheck source=lib/config.sh
. "$script_dir/lib/config.sh"
# shellcheck source=lib/inventory.sh
. "$script_dir/lib/inventory.sh"
# shellcheck source=lib/plan-contracts.sh
. "$script_dir/lib/plan-contracts.sh"
# shellcheck source=lib/plan-seal.sh
. "$script_dir/lib/plan-seal.sh"
# shellcheck source=lib/plan-verify.sh
. "$script_dir/lib/plan-verify.sh"
# shellcheck source=lib/plan-apply.sh
. "$script_dir/lib/plan-apply.sh"
# shellcheck source=lib/broker-windows.sh
. "$script_dir/lib/broker-windows.sh"
# shellcheck source=lib/broker-posix.sh
. "$script_dir/lib/broker-posix.sh"
# shellcheck source=lib/apply-commands.sh
. "$script_dir/lib/apply-commands.sh"
# shellcheck source=lib/fleet-store.sh
. "$script_dir/lib/fleet-store.sh"
# shellcheck source=lib/fleet-init.sh
. "$script_dir/lib/fleet-init.sh"
# shellcheck source=lib/fleet-fold.sh
. "$script_dir/lib/fleet-fold.sh"
# shellcheck source=lib/fleet-records.sh
. "$script_dir/lib/fleet-records.sh"
# shellcheck source=lib/fleet-vcs.sh
. "$script_dir/lib/fleet-vcs.sh"
# shellcheck source=lib/fleet-trust.sh
. "$script_dir/lib/fleet-trust.sh"
# shellcheck source=lib/fleet-resolve.sh
. "$script_dir/lib/fleet-resolve.sh"
# shellcheck source=lib/fleet-run.sh
. "$script_dir/lib/fleet-run.sh"
# shellcheck source=lib/fleet-doctor.sh
. "$script_dir/lib/fleet-doctor.sh"

# Definitions only: a caller that sources this file for its functions stops
# here, before dispatch. The self-check suite uses it to reach internal
# helpers without reproducing the file's layout.
[ -z "${ROUNDHOUSE_LIB_ONLY:-}" ] || return 0 2>/dev/null || exit 0

command=${1:-}
[ -n "$command" ] || usage
shift
case $command in
  validate-config) [ $# -eq 0 ] || usage; validate_config_file ;;
  validate-privilege-policy) [ $# -eq 1 ] || usage; validate_privilege_policy_file "$1" ;;
  inspect-privilege-constraints)
    [ $# -eq 2 ] || usage
    inspect_privilege_constraints_file "$1" "$2"
    ;;
  check-mutation-config) [ $# -eq 0 ] || usage; check_mutation_config ;;
  worker-config) [ $# -eq 3 ] || usage; worker_config_command "$1" "$2" "$3" ;;
  collect) collect_command "$@" ;;
  validate) [ $# -eq 1 ] || usage; validate_stream "$1" ;;
  render) render_command "$@" ;;
  compare) [ $# -eq 2 ] || usage; compare_command "$1" "$2" ;;
  executor-status) [ $# -le 1 ] || usage; executor_status_command "${1:--}" ;;
  verify-executor)
    [ $# -le 1 ] || usage
    if [ $# -eq 0 ]; then executor_status_command -; else verify_executor_requirement "$1"; fi
    ;;
  approve-codex-plugin-hooks)
    [ $# -eq 1 ] || usage
    codex_plugin_hooks_command approve "$1"
    ;;
  update-codex-plugin)
    [ $# -eq 1 ] || usage
    codex_plugin_hooks_command update "$1"
    ;;
  privilege-status) [ $# -eq 2 ] || usage; privilege_status_command "$1" "$2" ;;
  prepare-privilege-identity)
    [ $# -eq 5 ] || usage
    prepare_privilege_identity_command "$1" "$2" "$3" "$4" "$5"
    ;;
  prepare-privilege-enrollment)
    [ $# -eq 2 ] || usage
    prepare_privilege_enrollment_command "$1" "$2"
    ;;
  record-codex-readiness) [ $# -eq 3 ] || usage; record_codex_readiness_command "$1" "$2" "$3" ;;
  profile-bundle) [ $# -eq 3 ] || usage; profile_bundle_command "$1" "$2" "$3" ;;
  seal-plan) [ $# -eq 3 ] || usage; seal_plan_command "$1" "$2" "$3" ;;
  verify-preconditions) [ $# -eq 2 ] || usage; verify_preconditions_command "$1" "$2" ;;
  verify-privilege-plan) [ $# -eq 2 ] || usage; verify_privilege_plan_command "$1" "$2" ;;
  apply-plan) [ $# -eq 3 ] || usage; apply_plan_command "$1" "$2" "$3" ;;
  submit-privilege-plan) [ $# -eq 3 ] || usage; submit_privilege_plan_command "$1" "$2" "$3" ;;
  lookup-privilege-result)
    [ $# -eq 3 ] || usage
    lookup_privilege_result_command "$1" "$2" "$3"
    ;;
  preview-privilege-upgrade)
    [ $# -eq 2 ] || usage
    preview_privilege_upgrade_command "$1" "$2"
    ;;
  preview-privilege-revocation)
    [ $# -eq 2 ] || usage
    preview_privilege_revocation_command "$1" "$2"
    ;;
  apply-native-plan) [ $# -eq 3 ] || usage; apply_plan_command "$1" "$2" "$3" true ;;
  apply-ssh-plan) [ $# -eq 3 ] || usage; apply_ssh_plan_command "$1" "$2" "$3" ;;
  dispatch-posix-request) [ $# -eq 0 ] || usage; dispatch_posix_request_command ;;
  fleet-init) [ $# -eq 0 ] || usage; fleet_init_command ;;
  fleet-enroll) [ $# -eq 0 ] || usage; fleet_enroll_command ;;
  fleet-add) [ $# -ge 1 ] || usage; fleet_add_command "$@" ;;
  fleet-join) [ $# -eq 1 ] || usage; fleet_join_command "$1" ;;
  fleet-remove) [ $# -ge 1 ] && [ $# -le 5 ] || usage; fleet_remove_command "$@" ;;
  fleet-renew) [ $# -ge 1 ] && [ $# -le 2 ] || usage; fleet_renew_command "$@" ;;
  fleet-reparent) [ $# -eq 0 ] || usage; fleet_reparent_command ;;
  fleet-reconstitute) [ $# -eq 1 ] || usage; fleet_reconstitute_command "$1" ;;
  fleet-checkpoint) [ $# -eq 0 ] || usage; fleet_checkpoint_command ;;
  fleet-reroot) [ $# -le 2 ] || usage; fleet_reroot_command "$@" ;;
  fleet-explain) [ $# -ge 1 ] && [ $# -le 2 ] || usage; fleet_explain_command "$@" ;;
  fleet-run) [ $# -le 1 ] || usage; fleet_run_command "$@" ;;
  fleet-seed) [ $# -eq 0 ] || usage; fleet_seed_command ;;
  fleet-review) [ $# -eq 3 ] || usage; fleet_review_command "$1" "$2" "$3" ;;
  fleet-apply) [ $# -eq 1 ] || usage; fleet_apply_command "$1" ;;
  fleet-accept) [ $# -eq 1 ] || usage; fleet_accept_command "$1" ;;
  fleet-hold) [ $# -eq 2 ] || usage; fleet_hold_command "$1" "$2" ;;
  fleet-pending) [ $# -eq 0 ] || usage; fleet_pending_command ;;
  fleet-journal) [ $# -eq 1 ] || usage; fleet_journal_command "$1" ;;
  fleet-finding)
    { [ $# -ge 2 ] && [ $# -le 3 ]; } || usage
    fleet_finding_command "$1" "$2" ${3+"$3"}
    ;;
  fleet-lock) [ $# -eq 0 ] || usage; fleet_lock_command ;;
  fleet-unlock) [ $# -eq 0 ] || usage; fleet_unlock_command ;;
  fleet-rollback) [ $# -ge 1 ] && [ $# -le 2 ] || usage; fleet_rollback_command "$@" ;;
  fleet-adopt-pin) [ $# -eq 2 ] || usage; fleet_adopt_pin_command "$1" "$2" ;;
  fleet-verify-remote) [ $# -eq 0 ] || usage; fleet_verify_remote_command ;;
  fleet-set-remote) [ $# -eq 1 ] || usage; fleet_set_remote_command "$1" ;;
  fleet-readiness) fleet_readiness_command "$@" ;;
  fleet-doctor) [ $# -eq 0 ] || usage; fleet_doctor_command ;;
  ensure-tools) [ $# -eq 0 ] || usage; fleet_ensure_tools_command ;;
  launcher-install) launcher_install_command "$@" ;;
  *) usage ;;
esac
