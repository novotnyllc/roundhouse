#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ "${ROUNDHOUSE_LAUNCHER_EMIT:-0}" != 1 ]; then
  [ "$#" -le 1 ] || {
    printf 'usage: launcher-install [DESTINATION]\n' >&2
    exit 64
  }
  exec "$script_dir/roundhouse" launcher-install "${1:-}"
fi
[ "$#" -eq 0 ] || {
  printf 'roundhouse: internal launcher emission does not accept a destination\n' >&2
  exit 64
}

cat <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

roundhouse_version_valid() {
  case "$1" in
    ''|*[!0-9.]*|.*|*.|*..*) return 1 ;;
  esac
}

roundhouse_version_gt() {
  awk -v a="$1" -v b="$2" '
    BEGIN {
      an = split(a, av, /[.]/)
      bn = split(b, bv, /[.]/)
      n = an > bn ? an : bn
      for (i = 1; i <= n; i++) {
        x = (i <= an ? av[i] : 0) + 0
        y = (i <= bn ? bv[i] : 0) + 0
        if (x > y) exit 0
        if (x < y) exit 1
      }
      exit 1
    }
  '
}

roundhouse_best=
for roundhouse_candidate in \
  "$HOME"/.claude/plugins/cache/*/roundhouse/*/scripts/roundhouse \
  "$HOME"/.codex/plugins/cache/*/roundhouse/*/scripts/roundhouse
do
  [ -x "$roundhouse_candidate" ] || continue
  roundhouse_version=${roundhouse_candidate%/scripts/roundhouse}
  roundhouse_version=${roundhouse_version##*/}
  roundhouse_version_valid "$roundhouse_version" || continue
  if [ -z "$roundhouse_best" ] || roundhouse_version_gt "$roundhouse_version" "$roundhouse_best_version"; then
    roundhouse_best=$roundhouse_candidate
    roundhouse_best_version=$roundhouse_version
  fi
done

[ -n "$roundhouse_best" ] || {
  printf 'roundhouse: no installed launcher target found\n' >&2
  exit 127
}
exec "$roundhouse_best" "$@"
EOF
